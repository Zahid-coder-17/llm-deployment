<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yori_bg"
    android:fitsSystemWindows="true">

    <!-- 1. Top Glass Header Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/yori_glass_surface">

        <!-- YORI Avatar Circle -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">
            
            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_terracotta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Y"
                android:textColor="@color/yori_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_badge_terracotta"
                android:backgroundTint="@color/yori_green" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YORI"
                    android:textColor="@color/yori_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="OFFLINE"
                    android:textColor="@color/yori_accent"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_thought_box"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maria-1B Core • Local Executive"
                android:textColor="@color/yori_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ChatGPT-Style New Conversation Button -->
        <ImageButton
            android:id="@+id/btnNewChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_thought_box"
            android:src="@drawable/ic_chat_plus"
            android:contentDescription="New Conversation"
            android:tint="@color/yori_text_primary" />
    </LinearLayout>

    <!-- 2. Scrollable Chat Stream (Glass background, takes flexible middle space) -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/chatMessagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Initial YORI Greeting -->
            <LinearLayout
                android:id="@+id/greetingBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="300dp"
                    android:background="@drawable/bg_bubble_agent"
                    android:padding="14dp"
                    android:text="Hello! I'm Yori, your on-device executive agent. I can chat, analyze documents, and execute real tasks on your phone."
                    android:textColor="@color/yori_text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/greetingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Now"
                    android:textColor="@color/yori_text_muted"
                    android:textSize="9sp"
                    android:layout_marginTop="3dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 3. Quick Action Suggestion Chips -->
    <LinearLayout
        android:id="@+id/quickSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAlarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_thought_box"
                android:padding="10dp"
                android:text="⏰ Check Alarms"
                android:textColor="@color/yori_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFlight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_thought_box"
                android:padding="10dp"
                android:text="✈ Flight Mode"
                android:textColor="@color/yori_text_secondary"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/chipWhatsApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_thought_box"
                android:padding="10dp"
                android:text="💬 Message Zahid"
                android:textColor="@color/yori_text_secondary"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipWifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_thought_box"
                android:padding="10dp"
                android:text="📶 Turn Off Wi-Fi"
                android:textColor="@color/yori_text_secondary"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Bottom Input Bar with Glassmorphism & Document Attachment -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="6dp"
        android:background="@color/yori_bg">

        <!-- Attached Document Pill (Shown when user attaches a document) -->
        <LinearLayout
            android:id="@+id/docAttachmentBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_doc_badge"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAttachedDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄 document.txt"
                android:textColor="@color/yori_text_primary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/btnRemoveDoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ✕"
                android:textColor="@color/yori_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Main Glass Input Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_input"
            android:padding="6dp">

            <!-- Document Attachment Button -->
            <ImageButton
                android:id="@+id/btnAttachDoc"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_thought_box"
                android:src="@drawable/ic_attach_file"
                android:contentDescription="Attach Document"
                android:tint="@color/yori_text_secondary"
                android:layout_marginEnd="4dp" />

            <!-- Speech to Text Microphone Button -->
            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_thought_box"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Speech to Text"
                android:tint="@color/yori_text_secondary" />

            <!-- Input Field with actionSend -->
            <EditText
                android:id="@+id/promptInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Message Yori or attach doc..."
                android:textColorHint="@color/yori_text_muted"
                android:textColor="@color/yori_text_primary"
                android:textSize="13sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:maxLines="3"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textShortMessage" />

            <!-- Send / Stop Button (ChatGPT Style morphing arrow <-> square) -->
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chatgpt_send"
                android:src="@drawable/ic_arrow_up"
                android:contentDescription="Send"
                android:tint="@color/yori_text_primary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
